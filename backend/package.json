		"drizzle-orm": "^1.0.0-rc.4",
		"express": "^5.3.0",
		"helmet": "^8.3.0",
		"http-status-codes": "^2.3.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.23.1",
		"postgres": "^3.4.9",
		"winston": "^3.19.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^22.10.0",
		"drizzle-kit": "^1.0.0-rc.4",
		"esbuild": "^0.28.2",
		"oxlint": "^1.88.0",
		"oxlint-tsgolint": "^7.0.2004",
		"tsx": "^4.20.0",
		"typescript": "^7.0.2"
