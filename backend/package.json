{
	"name": "backend",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"seed:admin": "tsx src/scripts/seed-admin.ts",
		"typecheck": "tsc --noEmit",
